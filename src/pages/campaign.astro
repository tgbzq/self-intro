---
import Base from '../layouts/base.astro'
import Window from '../coms/windows.astro';

const pageTitle = "部长竞选 · 彭修远"
---

<Base pageTitle={pageTitle}>

  <div class="container-fluid min-vh-100 py-5 mt-4">
    <div class="row justify-content-center">
      <div class="col-12 col-md-10">

        <!-- 标题 -->
        <div class="row mb-4">
          <div class="col-12">
            <Window title="竞选演讲 — 候选人：彭修远" icon="computer_explorer-4.png">
              <div class="d-flex align-items-center gap-3">
                <div class="text-center flex-shrink-0">
                  <img src="/avatar.jpg" alt="头像" class="candidate-img">
                  <div class="mt-1 fw-bold small">@tgbz</div>
                </div>
                <div>
                  <h3 class="fw-bold mb-1" style="color: #000080;">彭修远</h3>
                  <p class="mb-1">数据科学与大数据技术专业</p>
                  <p class="mb-0 small text-muted"></p>我能做什么、做过什么、还想学什么</p>
                </div>
              </div>
            </Window>
          </div>
        </div>

        <div class="row gy-4">

          <!-- ===== 左侧：技能栈 ===== -->
          <div class="col-12 col-md-6">
            <Window title="技能清单" icon="computer_explorer-4.png">

              <div class="skill-section">
                <h6 class="skill-cat">■ 编程能力</h6>
                <p class="skill-desc">
                  C++ 为主力语言，有较多实践积累（OOP、STL、算法实现）。代码习惯良好，使用 Git 做版本管理。
                </p>
              </div>

              <div class="skill-section">
                <h6 class="skill-cat">■ 数据分析与建模</h6>
                <p class="skill-desc">
                  能使用 Python 配合 Pandas、NumPy、Matplotlib 完成建模中的数据处理与可视化任务，
                  目前正在系统补充统计学知识与 Scikit-learn 等工具库。
                </p>
              </div>

              <div class="skill-section">
                <h6 class="skill-cat">■ 服务器与基础设施</h6>
                <p class="skill-desc">
                  这是目前投入精力最多的方向。在家用一台老旧主机上部署了 <strong>Proxmox VE</strong> 虚拟化集群，
                  通过 <strong>WireGuard 虚拟组网</strong> + <strong>内网穿透</strong> 实现外网访问，
                  在上面运行了多个 Linux 虚拟机和 LXC 容器。
                </p>
                <p class="skill-desc mt-1" style="border-left: 3px solid #000080; padding-left: 10px; font-size: 0.8rem;">
                  涉及：Debian/Ubuntu 系统管理 · iptables 网络配置 · ZFS 存储管理 · frp 内网穿透
                </p>
              </div>

              <div class="skill-section">
                <h6 class="skill-cat">■ Web 与部署</h6>
                <p class="skill-desc">
                  能使用 Astro + Bootstrap 搭建前端页面，通过 Cloudflare Pages 做持续部署。
                  正在学习后端开发，目标是能搭建完整的数据展示 Web 应用。
                </p>
              </div>

            </Window>
          </div>

          <!-- ===== 右侧：实战经历 ===== -->
          <div class="col-12 col-md-6">
            <Window title="实战经历" icon="notepad-1.png">

              <div class="exp-item">
                <div class="exp-date">2026.02</div>
                <div class="exp-body">
                  <strong>MCM/ICM 数学建模竞赛</strong>
                  <p class="mb-0 exp-detail">
                    全程参赛，在三人团队中担任建模手。四天之内经历了从问题分析、
                    模型构建、代码实现到论文撰写的全流程，对比赛节奏和团队分工有切身体感。
                  </p>
                </div>
              </div>

              <hr class="dashed">

              <div class="exp-item">
                <div class="exp-date">2026.01 —</div>
                <div class="exp-body">
                  <strong>PVE 虚拟化集群搭建</strong>
                  <span class="badge bg-dark" style="font-size: 0.65rem;">INFRA</span>
                  <p class="mb-0 exp-detail">
                    利用一台旧 PC 主机部署 Proxmox VE 虚拟化平台，在上面划分了多个 Linux 虚拟机
                    与 LXC 容器，分别运行不同的服务。通过 WireGuard 搭建虚拟局域网、配置 frp
                    实现内网穿透，从公网可以访问家庭内网的服务。
                  </p>
                  <img src="/PVE.png" alt="PVE 控制面板截图" class="pve-screenshot" onclick="openLightbox(this)">
                </div>
              </div>

              <hr class="dashed">

              <div class="exp-item">
                <div class="exp-date">2026.01</div>
                <div class="exp-body">
                  <strong>个人网站全流程搭建</strong>
                  <p class="mb-0 exp-detail">
                    独立完成从技术选型、前端开发到部署的全流程。
                    网站通过 Cloudflare Pages 自动构建发布，绑定自定义域名。
                  </p>
                </div>
              </div>

              <hr class="dashed">

              <div class="exp-item">
                <div class="exp-date">进行中</div>
                <div class="exp-body">
                  <strong>数据科学与 Web 全栈学习</strong>
                  <p class="mb-0 exp-detail">
                    正在补统计学基础和机器学习工具链，同时往后端方向拓展。
                    目标是能将建模成果以可交互的 Web 应用形式呈现。
                  </p>
                </div>
              </div>

            </Window>
          </div>

        </div>

        <!-- ===== 底部：竞选理由 ===== -->
        <div class="row mt-4">
          <div class="col-12">
            <Window title="为什么选我" icon="notepad-1.png">
              <div class="row">
                <div class="col-md-8">
                  <p>
                    这个职位需要的不是技术水平最高的人，而是<strong>有执行意愿、能把事情落地</strong>的人。
                    我未必是候选人中技术最突出的，但具备独立规划并完成一项技术工作的实际经验。
                  </p>
                  <p class="mb-0">
                    美赛走完全程使我理解比赛的流程与常见困难；自建服务器并长期维护让我对信息组织和持续运维
                    有真实的操作体感——这也是我对资料库建设有信心的原因。如果我当选，不会空谈愿景，
                    而是按照执行计划逐项落实。
                  </p>
                </div>
                <div class="col-md-4 text-center d-flex flex-column justify-content-center border-start border-2 border-dark ps-3">
                  <div class="fw-bold" style="color: #000080; font-size: 0.9rem;">能干活 · 愿意学 · 好沟通</div>
                  <div class="text-muted small mt-1">选了不亏</div>
                </div>
              </div>
            </Window>
          </div>
        </div>

        <!-- ===== 当选后执行政策 ===== -->
        <div class="row mt-4">
          <div class="col-12">
            <Window title="当选执行计划.exe" icon="msagent-4.png">
              <div class="row g-3">
                <div class="col-md-4">
                  <div class="policy-card">
                    <div class="policy-num">01</div>
                    <h6 class="fw-bold">协会资料库建设</h6>
                    <p class="small mb-0 text-muted">
                      把历年优秀论文、通用代码模板、赛题数据按主题归档，
                      搭建可检索的协会资源库，让新成员入会不用从零起步，也让每一届的产出能沉淀下来。
                    </p>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="policy-card">
                    <div class="policy-num">02</div>
                    <h6 class="fw-bold">协作规范与工具链</h6>
                    <p class="small mb-0 text-muted">
                      引入 Git 版本管理和 Markdown 文档规范，
                      让论文和代码的多人协作更顺畅。协会的产出不只是 PDF，更是可复用、可追溯的代码资产。
                    </p>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="policy-card">
                    <div class="policy-num">03</div>
                    <h6 class="fw-bold">跨学科组队对接</h6>
                    <p class="small mb-0 text-muted">
                      按编程/建模/写作方向建立人才信息池，
                      主动对接其他学院引入多元背景的同学，帮大家找到互补的队友，减少因组队问题错失比赛机会。
                    </p>
                  </div>
                </div>
              </div>
            </Window>
          </div>
        </div>

      </div>
    </div>
  </div>

</Base>

<!-- 点击看大图遮罩 -->
<div id="lightbox" class="lightbox" onclick="closeLightbox()">
  <span class="lightbox-close">&times;</span>
  <img id="lightbox-img" class="lightbox-content" src="" alt="放大预览">
</div>

<script is:inline>
function openLightbox(img) {
  document.getElementById('lightbox-img').src = img.src;
  document.getElementById('lightbox').classList.add('show');
}

function closeLightbox() {
  document.getElementById('lightbox').classList.remove('show');
}

document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') closeLightbox();
});
</script>

<style>
  .candidate-img {
    width: 90px;
    height: 90px;
    object-fit: cover;
    border: 2px solid #c0c0c0;
  }

  .skill-section {
    margin-bottom: 16px;
  }

  .skill-cat {
    font-family: "Courier New", monospace;
    font-weight: bold;
    color: #000080;
    font-size: 0.9rem;
    margin-bottom: 4px;
    border-bottom: 1px dashed #ccc;
    padding-bottom: 2px;
  }

  .skill-desc {
    font-size: 0.85rem;
    color: #333;
    margin-bottom: 0;
    line-height: 1.6;
  }

  .exp-item {
    display: flex;
    gap: 10px;
  }

  .exp-date {
    min-width: 70px;
    font-family: "Courier New", monospace;
    font-weight: bold;
    color: #000080;
    font-size: 0.8rem;
    flex-shrink: 0;
  }

  .exp-body {
    font-size: 0.85rem;
  }

  .exp-detail {
    font-size: 0.8rem;
    color: #555;
    margin-top: 2px;
    line-height: 1.5;
  }

  .dashed {
    border: none;
    border-top: 1px dashed #aaa;
    margin: 10px 0;
  }

  .policy-card {
    background: #f5f5f7;
    border: 2px solid;
    border-color: #fff #808080 #808080 #fff;
    padding: 14px;
    height: 100%;
  }

  .policy-num {
    font-family: "Courier New", monospace;
    font-size: 0.75rem;
    color: #000080;
    font-weight: bold;
    margin-bottom: 4px;
  }

  .policy-card h6 {
    margin-bottom: 6px;
    color: #000080;
    font-size: 0.9rem;
  }

  .pve-screenshot {
    width: 100%;
    margin-top: 10px;
    border: 2px solid;
    border-color: #fff #808080 #808080 #fff;
    box-shadow: inset 1px 1px 0px #dfdfdf;
    cursor: pointer;
  }

  /* 点击看大图 */
  .lightbox {
    display: none;
    position: fixed;
    z-index: 9999;
    inset: 0;
    background: rgba(0,0,0,0.85);
    align-items: center;
    justify-content: center;
  }

  .lightbox.show {
    display: flex;
  }

  .lightbox-content {
    max-width: 90%;
    max-height: 90%;
    object-fit: contain;
    border: 3px solid #c0c0c0;
    box-shadow:
      inset 1px 1px 0px #fff,
      inset -1px -1px 0px #808080,
      2px 2px 0px #000;
  }

  .lightbox-close {
    position: absolute;
    top: 16px;
    right: 24px;
    color: #c0c0c0;
    font-size: 2.5rem;
    font-weight: bold;
    cursor: pointer;
    font-family: "Courier New", monospace;
    text-shadow: 2px 2px 0 #000;
  }

  .lightbox-close:hover {
    color: #fff;
  }
</style>
